# Database
DATABASE_URL=""

# Backend Framework Adapter
# Adaptador de errores HTTP. Valores disponibles: fastapi | laravel
# Afecta cómo se parsean los errores del backend en la infraestructura HTTP.
NEXT_PUBLIC_BACKEND_ADAPTER=

# Better Auth
# Genera un secreto seguro con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# En desarrollo: http://localhost:3000 | En producción: https://tu-dominio.com
BETTER_AUTH_URL=
# URL pública de la app (usada por el auth-client en el browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Plugin (Better Auth)
# Tiempo de vida del JWT enviado al backend externo.
# Recomendado: corto (15m, 1h) por seguridad. La sesión de Better Auth
# se renueva automáticamente; el JWT se refresca con un nuevo getJWT().
# Ejemplos: "15m" | "30m" | "1h" | "2h"
JWT_EXPIRATION_TIME=15m

# Identificador del emisor del JWT (tu app Next.js).
# Debe coincidir con lo que el backend valide en el campo "iss" del JWT.
# Por defecto usa BETTER_AUTH_URL si no se define.
JWT_ISSUER=http://localhost:3000

# Identificador del receptor del JWT (tu backend externo).
# El backend puede validar que el token fue emitido para él con el campo "aud".
# Dejar vacío si no necesitas validación de audience.
JWT_AUDIENCE=

# URL del backend externo al que se conecta el api-client.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# Social Providers (OAuth)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo for emails
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=""